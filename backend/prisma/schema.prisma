generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id           String   @id @default(cuid())
  battleNetId  String?
  name         String
  realm        String
  realmSlug    String?
  region       String   @default("eu")
  className    String
  level        Int      @default(80)
  source       String   @default("MANUAL")
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professions CharacterProfession[]

  @@unique([name, realm, region])
  @@index([battleNetId, region])
  @@index([source])
}

model Profession {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  category String
  order    Int    @default(0)

  assignments CharacterProfession[]
}

model CharacterProfession {
  id                    String  @id @default(cuid())
  characterId           String
  professionId          String
  skill                 Int     @default(0)
  knowledgePoints       Int     @default(0)
  specializationSummary String?

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([characterId, professionId])
}

model BattleNetConnection {
  id          String   @id
  battleTag   String?
  accessToken String
  tokenType   String
  scope       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BattleNetOAuthState {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}