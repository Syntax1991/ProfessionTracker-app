generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id           String    @id @default(cuid())
  battleNetId  String?
  name         String
  realm        String
  realmSlug    String?
  region       String    @default("eu")
  className    String
  level        Int       @default(80)
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  professions CharacterProfession[]

  @@unique([name, realm, region])
  @@index([battleNetId, region])
  @@index([source])
}

model Profession {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  category String
  order    Int    @default(0)

  assignments         CharacterProfession[]
  specializationTrees ProfessionSpecializationTree[]
  capabilities        CraftCapability[]
  recipes             CraftRecipe[]
}

model CharacterProfession {
  id                    String @id @default(cuid())
  characterId           String
  professionId          String
  skill                 Int    @default(0)
  skillModifier         Int    @default(0)
  knowledgePoints       Int    @default(0)
  specializationSummary String?

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  nodeProgress CharacterProfessionNodeProgress[]
  recipes      CharacterCraftRecipe[]

  @@unique([characterId, professionId])
  @@index([professionId])
}

model ProfessionSpecializationTree {
  id           String @id @default(cuid())
  professionId String
  expansion    String @default("MIDNIGHT")
  key          String
  name         String
  description  String?
  sortOrder    Int    @default(0)

  profession Profession                     @relation(fields: [professionId], references: [id], onDelete: Cascade)
  nodes      ProfessionSpecializationNode[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
}

model ProfessionSpecializationNode {
  id               String @id @default(cuid())
  treeId           String
  parentNodeId     String?
  key              String
  name             String
  description      String?
  maxRank          Int?
  knowledgeMaxRank Int?
  sortOrder        Int    @default(0)

  tree     ProfessionSpecializationTree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent   ProfessionSpecializationNode?  @relation("SpecializationNodeHierarchy", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children ProfessionSpecializationNode[] @relation("SpecializationNodeHierarchy")
  progress CharacterProfessionNodeProgress[]

  @@unique([treeId, key])
  @@index([treeId, parentNodeId])
}

model CharacterProfessionNodeProgress {
  id                    String    @id @default(cuid())
  characterProfessionId String
  nodeId                String
  rank                  Int       @default(1)
  knowledgeRank         Int?
  unlockRank            Int?
  source                String    @default("MANUAL")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  characterProfession CharacterProfession          @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  node                ProfessionSpecializationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, nodeId])
  @@index([nodeId])
  @@index([source])
}

model CraftCapability {
  id           String @id @default(cuid())
  professionId String
  expansion    String @default("MIDNIGHT")
  key          String
  name         String
  type         String
  slotKey      String?
  description  String?
  sortOrder    Int    @default(0)

  profession Profession              @relation(fields: [professionId], references: [id], onDelete: Cascade)
  recipes    CraftRecipeCapability[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
  @@index([professionId, expansion, type])
}

model CraftRecipe {
  id                   String    @id @default(cuid())
  professionId         String
  gameRecipeId         Int
  skillLineId          Int?
  expansion            String    @default("MIDNIGHT")
  name                 String
  categoryId           Int?
  craftedItemId        Int?
  baseDifficulty       Int?
  operationMetricsJson String?
  source               String    @default("ADDON")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profession   Profession               @relation(fields: [professionId], references: [id], onDelete: Cascade)
  capabilities CraftRecipeCapability[]
  characters   CharacterCraftRecipe[]

  @@unique([professionId, gameRecipeId])
  @@index([professionId, expansion])
  @@index([gameRecipeId])
  @@index([craftedItemId])
}

model CraftRecipeCapability {
  craftRecipeId String
  capabilityId  String
  isPrimary     Boolean @default(false)

  recipe     CraftRecipe     @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)
  capability CraftCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([craftRecipeId, capabilityId])
  @@index([capabilityId])
}

model CharacterCraftRecipe {
  id                          String    @id @default(cuid())
  characterProfessionId       String
  craftRecipeId               String
  learned                     Boolean   @default(true)
  baseSkill                   Int?
  bonusSkill                  Int?
  effectiveSkill              Int?
  craftingQuality             Int?
  craftingQualityId           Int?
  guaranteedCraftingQualityId Int?
  lowerSkillThreshold         Int?
  upperSkillThreshold         Int?
  concentrationCost           Int?
  concentrationCurrencyId     Int?
  ingenuityRefund             Int?
  quality                     Float?
  operationMetricsJson        String?
  operationCapturedAt         DateTime?
  operationCaptureVersion     Int?
  operationScopeVersion       Int?
  source                      String    @default("ADDON")
  lastSyncedAt                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  characterProfession CharacterProfession @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  recipe              CraftRecipe         @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, craftRecipeId])
  @@index([craftRecipeId])
  @@index([source])
  @@index([operationCaptureVersion])
}

model BattleNetConnection {
  id          String   @id
  battleTag   String?
  accessToken String
  tokenType   String
  scope       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BattleNetOAuthState {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}